<Window x:Class="RefDataMvvm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RefDataMvvm.Wpf.Views"
        xmlns:behaviors="clr-namespace:RefDataMvvm.Wpf.Behaviors"
        Title="RefData · MVVM 테스트 (.NET Framework 4.8)"
        Width="1020" Height="740" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA"
        FontFamily="Malgun Gothic" FontSize="14" Foreground="#17273E" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="WPF  /  .NET FRAMEWORK 4.8" FontSize="12" FontWeight="Bold" Foreground="#48688D" />
                <TextBlock Text="같은 데이터, 두 개의 ViewModel" FontSize="30" FontWeight="Bold" Margin="0,10,0,8" />
                <TextBlock Text="버튼을 누르면 횟수가 증가하고, 오른쪽 위 스피너가 켜지거나 꺼집니다. 두 화면은 같은 데이터를 봅니다." Foreground="#586B82" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="1" Background="#E5EDF8" CornerRadius="10" Margin="0,18,0,18" DataContext="{Binding Menu}">
                <Grid x:Name="PopupToolbar" Background="Transparent">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="18,12,18,0">
                        <Button x:Name="ToolbarFirst" Content="버튼 1" Command="{Binding FirstCommand}" Margin="0,0,10,0" />
                        <Button x:Name="ToolbarSecond" Content="버튼 2" Command="{Binding SecondCommand}" Margin="0,0,10,0" />
                        <ToggleButton x:Name="PopupToggle" Content="팝업 목록 ▾" Padding="18,10"
                                      IsChecked="{Binding IsOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding LastAction}" Foreground="#48688D" FontSize="12" Margin="18,8,18,12" />
                    <Popup x:Name="ActionPopup" PlacementTarget="{Binding ElementName=PopupToggle}" Placement="Bottom"
                           VerticalOffset="6" StaysOpen="True" AllowsTransparency="True"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                           IsOpen="{Binding IsOpen, Mode=TwoWay}"
                           behaviors:PopupDismissBehavior.CloseCommand="{Binding CloseCommand}"
                           behaviors:PopupDismissBehavior.KeepOpenElement="{Binding ElementName=PopupToolbar}">
                        <Border Background="White" BorderBrush="#A9BAD0" BorderThickness="1" CornerRadius="10">
                            <Grid x:Name="PopupListGrid" Background="Transparent" MinWidth="260">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="빈 공간 · 사용 불가 버튼은 유지" FontSize="12" Foreground="#586B82" Margin="18,16,18,8" />
                                <ItemsControl x:Name="PopupItems" Grid.Row="1" ItemsSource="{Binding Items}" Margin="18,0,18,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Title}" IsEnabled="{Binding IsEnabled}"
                                                    Command="{Binding Command}" Margin="0,4" HorizontalContentAlignment="Stretch" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:CounterView DataContext="{Binding Left}" />
                <views:CounterView Grid.Column="2" DataContext="{Binding Right}" UseOpacitySpinner="True" />
                <Border x:Name="PopupDim" Grid.ColumnSpan="3" Panel.ZIndex="10" Background="#660C182A"
                        Visibility="{Binding Menu.IsOpen, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Text="이 영역을 누르면 팝업이 닫힙니다" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Border>
            </Grid>
            <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="ViewModel을 교체해도 원본은 유지됩니다" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="오른쪽 ViewModel의 구독을 해제하고 같은 Model로 새로 만듭니다." Foreground="#586B82" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="오른쪽 VM 다시 만들기" Command="{Binding RecreateRightCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
