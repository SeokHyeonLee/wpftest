<Window x:Class="RefDataMvvm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RefDataMvvm.Wpf.Views"
        Title="RefData · MVVM 테스트 (.NET Framework 4.8)"
        Width="1020" Height="740" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA"
        FontFamily="Malgun Gothic" FontSize="14" Foreground="#17273E" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="WPF  /  .NET FRAMEWORK 4.8" FontSize="12" FontWeight="Bold" Foreground="#48688D" />
                <TextBlock Text="같은 데이터, 두 개의 ViewModel" FontSize="30" FontWeight="Bold" Margin="0,10,0,8" />
                <TextBlock Text="버튼을 누르면 횟수가 증가하고, 오른쪽 위 스피너가 켜지거나 꺼집니다. 두 화면은 같은 데이터를 봅니다." Foreground="#586B82" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="1" Background="#E5EDF8" CornerRadius="10" Padding="18,14" Margin="0,22,0,22">
                <StackPanel>
                    <TextBlock Text="Model의 원본 Data → RefData 참조 → ViewModel → 바인딩된 View" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="value로 원본 수정 · changed() 또는 changedflag = true로 변경 알림" Margin="0,6,0,0" FontSize="12" Foreground="#48688D" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:CounterView DataContext="{Binding Left}" />
                <views:CounterView Grid.Column="2" DataContext="{Binding Right}" UseOpacitySpinner="True" />
            </Grid>
            <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="ViewModel을 교체해도 원본은 유지됩니다" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="오른쪽 ViewModel의 구독을 해제하고 같은 Model로 새로 만듭니다." Foreground="#586B82" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="오른쪽 VM 다시 만들기" Command="{Binding RecreateRightCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
