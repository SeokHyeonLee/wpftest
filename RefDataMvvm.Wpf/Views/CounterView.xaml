<UserControl x:Class="RefDataMvvm.Wpf.Views.CounterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RefDataMvvm.Wpf.Controls"
             xmlns:local="clr-namespace:RefDataMvvm.Wpf.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="RotationSpinnerTemplate">
            <controls:LoadingSpinner IsActivate="{Binding IsActivate, Mode=OneWay}"
                                     DotBrush="{Binding SpinnerColor, Mode=OneWay}"
                                     Width="32" Height="32" Background="White" />
        </DataTemplate>
        <DataTemplate x:Key="OpacitySpinnerTemplate">
            <controls:LoadingSpinner2 IsActivate="{Binding IsActivate, Mode=OneWay}"
                                      DotBrush="{Binding SpinnerColor, Mode=OneWay}"
                                      Width="32" Height="32" Background="White" />
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="White" CornerRadius="14" BorderBrush="#DCE4EE" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding PanelName}" FontSize="16" FontWeight="Bold" />
            <TextBlock Foreground="#586B82" FontSize="12" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="점이 원을 따라 회전합니다" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseOpacitySpinner, RelativeSource={RelativeSource AncestorType={x:Type local:CounterView}}}" Value="True">
                                <Setter Property="Text" Value="점은 고정되고 밝기만 순환합니다" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                <TextBlock Text="{Binding ClickCount, Mode=OneWay}" FontSize="58" FontWeight="Bold" Foreground="#2463CE" />
                <TextBlock Text="회" FontSize="18" VerticalAlignment="Bottom" Margin="8,0,0,12" />
            </StackPanel>
            <TextBlock Text="{Binding Information, Mode=OneWay}" TextWrapping="Wrap" MinHeight="44" />
            <TextBlock Text="마지막으로 누른 시간" FontSize="11" Foreground="#75869B" Margin="0,14,0,4" />
            <TextBlock Text="{Binding LastClickedAtText, Mode=OneWay}" FontSize="13" />
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid>
                    <Button Content="눌러서 +1" Command="{Binding ClickCommand}" Background="#2463CE" Foreground="White"
                            ToolTip="클릭 횟수를 늘리고 스피너를 켜거나 끕니다." />
                    <!-- overlay: 스피너가 접혀도 버튼 크기/좌표는 바뀌지 않는다. -->
                    <ContentControl Content="{Binding}" Width="32" Height="32"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-16,-10,0" Panel.ZIndex="1"
                                    Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource RotationSpinnerTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseOpacitySpinner, RelativeSource={RelativeSource AncestorType={x:Type local:CounterView}}}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource OpacitySpinnerTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
                <Button Grid.Column="2" Content="초기화" Command="{Binding ResetCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
